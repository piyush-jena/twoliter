# shellcheck shell=bash
# Shared image-builder support for version 1 of the systemd-boot A/B layout.
# This file is sourced by rpm2img after root/verity construction.

build_update_ukis() {
  local stage slot stub loader kver uki_path part number
  stage="${BOOT_MOUNT}/.uki-ab"
  mkdir -p "${stage}"
  mapfile -t stubs < <(find "${ROOT_MOUNT}/usr/lib/systemd/boot/efi" -name 'linux*.efi.stub' -type f)
  [[ "${#stubs[@]}" == 1 ]] || { echo "expected one systemd stub" >&2; return 1; }
  stub="${stubs[0]}"
  loader="${BOOT_MOUNT}/efi/EFI/BOOT/systemd-boot${efi_arch}.efi"
  [[ -s "${loader}" ]] || { echo "systemd-boot loader missing" >&2; return 1; }
  mapfile -t kernels < <(find "${ROOT_MOUNT}/lib/modules" -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
  [[ "${#kernels[@]}" == 1 ]] || { echo "expected one kernel/module tree" >&2; return 1; }
  kver="${kernels[0]}"
  # The patched, signed stub resolves this token from its own GPT boot device.
  strings --encoding=l "${stub}" | grep -Fx '@BOOT_PARTUUID@' >/dev/null ||
    { echo "systemd stub lacks Bottlerocket disk resolution" >&2; return 1; }

  # Both loader and UKI must chain to firmware db. Never enroll or use a key
  # generated on the updating host.
  sign_uki "${loader}"
  mcopy -i "${EFI_IMAGE}" "${loader}" "::/EFI/BOOT/BOOT${efi_arch^^}.EFI"
  mmd -i "${EFI_IMAGE}" ::/EFI/Linux ::/EFI/Bottlerocket ::/loader
  printf '%s\n' 'default bottlerocket-A*.efi' 'timeout 0' 'editor no' \
    'auto-entries no' 'auto-firmware no' >"${stage}/loader.conf"
  mcopy -i "${EFI_IMAGE}" "${stage}/loader.conf" ::/loader/loader.conf

  local -a table
  local -A numbers
  number=1
  for part in "${partitions[@]}"; do
    numbers["${part}"]="${number}"
    number=$((number + 1))
  done
  for slot in A B; do
    table=("${DM_VERITY_ROOT[@]}")
    table[4]="PARTUUID=@BOOT_PARTUUID@/PARTNROFF=$((numbers[ROOT-${slot}] - numbers[EFI-A]))"
    table[5]="PARTUUID=@BOOT_PARTUUID@/PARTNROFF=$((numbers[HASH-${slot}] - numbers[EFI-A]))"
    uki_path="${stage}/bottlerocket-${slot}.efi"
    ukify build \
      --stub "${stub}" \
      --linux "${BOOT_MOUNT}/vmlinuz" \
      --uname "${kver}" \
      --cmdline "${KERNEL_PARAMETERS} $(uki_bootconfig_cmdline "${VARIANT}") root=/dev/dm-0 rootwait ro raid=noautodetect random.trust_cpu=on panic=10 selinux=1 enforcing=1 dm-mod.create=\"${table[*]}\" -- systemd.log_target=journal-or-kmsg" \
      --os-release "@${ROOT_MOUNT}/usr/lib/os-release" \
      --output "${uki_path}"
    sign_uki "${uki_path}"
    generate_hmac "${uki_path}" "EFI/Linux/bottlerocket-${slot}.efi"
    lz4 -c "${uki_path}" >"${OUTPUT_DIR}/${FILENAME_PREFIX}-uki-${slot}.efi.lz4"
    lz4 -c "${stage}/.bottlerocket-${slot}.efi.hmac" >"${OUTPUT_DIR}/${FILENAME_PREFIX}-uki-${slot}.hmac.lz4"
    if [[ "${slot}" == A ]]; then
      mcopy -i "${EFI_IMAGE}" "${uki_path}" ::/EFI/Linux/bottlerocket-A.efi
      mcopy -i "${EFI_IMAGE}" "${stage}/.bottlerocket-A.efi.hmac" ::/EFI/Bottlerocket/bottlerocket-A.hmac
    fi
  done
  dd if="${EFI_IMAGE}" of="${OS_IMAGE}" conv=notrunc bs=1M seek="${partoff["EFI-A"]}"
  rm -rf "${stage}"
  rm -f "${BOOT_MOUNT}/vmlinuz"
}
